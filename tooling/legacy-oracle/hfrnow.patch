+    private func mpStorage() -> NSObject {
+        guard let type = NSClassFromString("MPStorage") as AnyObject?,
+              let shared = type.perform(NSSelectorFromString("shared"))?.takeUnretainedValue() as? NSObject else { fatalError("MPStorage missing") }
+        return shared
+    }
+
+    /// The flags the shared MPStorage keeps between calls, set back to their launch values (MPStorage.m:71-72): a case that
+    /// fails a save would otherwise leave bIsMPStorageSavedSuccessfully NO for every later case.
+    private func resetMPStorageFlags(_ mp: NSObject) {
+        mp.setValue(false, forKey: "bIsActive")
+        mp.setValue(true, forKey: "bIsMPStorageSavedSuccessfully")
+    }
+
+    private func bookmarkDict(_ bookmark: NSObject) -> [String: Any] {
+        var dict: [String: Any] = [:]
+        for key in ["sPost", "sCat", "sNumResponse", "sLabel", "sAuthorPost"] { dict[key] = plain(bookmark.value(forKey: key)) }
+        // a bookmark just added carries createDate = TIMESTAMP (MPStorage.m:28, :343), read back as dateBookmarkCreation
+        // (MPStorage.m:606-607): keep the output reproducible
+        if let date = bookmark.value(forKey: "dateBookmarkCreation") as? Date, abs(date.timeIntervalSinceNow) < 3 * 24 * 3600 {
+            dict["dateBookmarkCreation"] = "<now>"
+        } else {
+            dict["dateBookmarkCreation"] = plain(bookmark.value(forKey: "dateBookmarkCreation"))
+        }
+        return dict
+    }
+
+    /// JSON-safe copy of a Foundation object graph (NSJSONSerialization accepts only those types).
+    private func jsonSafe(_ value: Any?) -> Any {
+        switch value {
+        case nil, is NSNull: return NSNull()
+        case let dict as [String: Any]: return dict.mapValues { jsonSafe($0) }
+        case let dict as NSDictionary: return Dictionary(uniqueKeysWithValues: dict.map { (String(describing: $0.key), jsonSafe($0.value)) })
+        case let array as [Any]: return array.map { jsonSafe($0) }
+        case is String, is NSNumber: return value!
+        default: return String(describing: value!)
+        }
+    }
+
+    /// Timestamps written at run time (TIMESTAMP, MPStorage.m:28) are replaced by a token so output is reproducible.
+    private func normalizeTimestamps(_ value: Any) -> Any {
+        let now = Date().timeIntervalSince1970 * 1000
+        let isRecent = { (number: NSNumber) -> Bool in abs(number.doubleValue - now) < 3 * 24 * 3600 * 1000 && number.doubleValue > 1e12 }
+        switch value {
+        case let dict as [String: Any]:
+            return dict.mapValues { normalizeTimestamps($0) }
+        case let array as [Any]:
+            return array.map { normalizeTimestamps($0) }
+        case let number as NSNumber where CFGetTypeID(number) != CFBooleanGetTypeID() && isRecent(number):
+            return "<now-ms>"
+        default:
+            return value
+        }
+    }
+
+    private func describeStorageRequests(_ log: [String: Any]) -> [[String: Any]] {
+        (log["requests"] as? [[String: Any]] ?? []).map { request in
+            var entry: [String: Any] = ["method": request["method"] ?? "", "url": request["url"] ?? ""]
+            if let pairs = request["pairs"] as? [[String]] {
+                entry["contentType"] = request["contentType"] ?? NSNull()
+                entry["pairs"] = pairs.map { pair -> [Any] in
+                    guard pair[0] == "content_form", let data = pair[1].data(using: .utf8),
+                          let object = try? JSONSerialization.jsonObject(with: data) else { return pair }
+                    let normalized = normalizeTimestamps(object)
+                    let text = (try? JSONSerialization.data(withJSONObject: normalized, options: [.sortedKeys, .withoutEscapingSlashes]))
+                        .flatMap { String(data: $0, encoding: .utf8) } ?? pair[1]
+                    return ["content_form", ["rawBytes": pair[1].utf8.count, "json": normalized, "jsonSorted": text] as [String: Any]]
+                }
+            }
+            return entry
+        }
+    }
