+/// spec: inputData, formSubmit, pseudo, hash, content (composer text, LF newlines), sujet/subcat/dest (field texts),
+/// haveTitle/haveCategory/haveTo, deleteMode.
++ (NSDictionary *)legacyPost:(NSDictionary *)spec {
+    @try {
+        NSDictionary *inputData = spec[@"inputData"];
+        NSString *formSubmit = spec[@"formSubmit"];
+        NSURL *url = [NSURL URLWithString:formSubmit];
+        id request = ((id (*)(id, SEL, NSURL *))objc_msgSend)([NSClassFromString(@"ASIFormDataRequest") alloc], NSSelectorFromString(@"initWithURL:"), url);
+        NSMutableDictionary *notes = [NSMutableDictionary dictionary];
+        if ([spec[@"flavor"] isEqualToString:@"alert"]) {
+            for (NSString *key in inputData) [request setPostValue:inputData[key] forKey:key]; // AlerteModoViewController.m:202-207
+            NSString *reason = [[spec[@"content"] removeEmoji] stringByReplacingOccurrencesOfString:@"\n" withString:@"\r\n"]; // :209-211
+            [request setPostValue:reason forKey:@"raison"];
+            notes[@"sentContent"] = [spec[@"content"] removeEmoji]; // what is really posted (before \n to \r\n); runForm moves it to postedContent
+        } else {
+            for (NSString *key in inputData) { // AddMessageViewController.m:519-552
+                if ([key isEqualToString:@"allowvisitor"] || [key isEqualToString:@"have_sondage"] || [key isEqualToString:@"sticky"] || [key isEqualToString:@"sticky_everywhere"]) {
+                    if ([inputData[key] isEqualToString:@"1"]) [request setPostValue:inputData[key] forKey:key]; // :521-526
+                } else if ([key isEqualToString:@"delete"]) {
+                    if ([spec[@"deleteMode"] boolValue]) [request setPostValue:@"1" forKey:key]; // :527-531
+                } else if ([key isEqualToString:@"pseudo"]) {
+                    [request setPostValue:spec[@"pseudo"] forKey:@"pseudo"]; // :532-535
+                } else if ([key isEqualToString:@"hash_check"]) {
+                    if (spec[@"hash"]) [request setPostValue:spec[@"hash"] forKey:@"hash_check"]; // :536-538
+                    else notes[@"hashFromAppDelegate"] = @YES; // :539-547 falls back to the app delegate (nil offline)
+                } else {
+                    [request setPostValue:inputData[key] forKey:key]; // :549-551
+                }
+            }
+            NSString *text = [[spec[@"content"] removeEmoji] stringByReplacingOccurrencesOfString:@"\n" withString:@"\r\n"]; // :553-554
+            [request setPostValue:text forKey:@"content_form"];
+            notes[@"sentContent"] = [spec[@"content"] removeEmoji]; // see the alert branch
+            if ([spec[@"haveTitle"] boolValue]) [request setPostValue:spec[@"sujet"] forKey:@"sujet"]; // :558-561
+            if ([spec[@"haveCategory"] boolValue]) [request setPostValue:spec[@"subcat"] forKey:@"subcat"]; // :562-565
+            if ([spec[@"haveTo"] boolValue]) [request setPostValue:spec[@"dest"] forKey:@"dest"]; // :566-569
+        }
+        NSMutableDictionary *out = [DescribePost(request) mutableCopy];
+        [out addEntriesFromDictionary:notes];
+        return out;
+    } @catch (NSException *exception) {
+        return @{@"exception": ExceptionString(exception)};
+    }
+}
