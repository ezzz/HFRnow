+// Oracle exporter helper (SwiftHFR LOT-002, LOT-003): calls an Objective-C method through NSInvocation and
+// turns a thrown NSException into data. The legacy parsers raise on malformed pages (nil URL,
+// out-of-bounds child index...), and Swift cannot catch NSException, so a raise would kill the run.
+//
+// LOT-003 adds the topic-page pipeline: hooks that replace the account store and the network for the run,
+// and two entry points that drive the real legacy classes (ObjCTopicPageWorker, ParseMessagesOperation).
+// Legacy classes are reached through the runtime only: no legacy header is imported.
+#import <Foundation/Foundation.h>
+#import <objc/message.h>
+#import <objc/runtime.h>
+
+@interface OracleObjCSafe : NSObject
++ (NSDictionary *)invoke:(NSDictionary *)spec;
++ (void)installTopicHooks;
++ (void)removeTopicHooks;
++ (void)setTopicHookPseudo:(NSString *)pseudo avatarMode:(NSString *)mode;
++ (NSArray *)drainNetworkRequests;
++ (void)setTopicHookHash:(NSString *)hash;
++ (NSData *)safeResponseDataFor:(NSData *)data url:(NSString *)url;
++ (NSDictionary *)runTopicWorker:(NSDictionary *)spec;
++ (NSDictionary *)parseMessagesRaw:(NSDictionary *)spec;
+@end
