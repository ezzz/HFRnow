+            return out;
+        }
+
+        // QuoteMessageViewController.m:127-140: logged-in flag and username
+        id hashCheckNode = [bodyNode findChildWithAttribute:@"name" matchingName:@"hash_check" allowPartial:NO];
+        out[@"isLogged"] = @((BOOL)(hashCheckNode && ![[hashCheckNode getAttributeNamed:@"value"] isEqualToString:@""]));
+        id usernameNode = [bodyNode findChildWithAttribute:@"name" matchingName:@"pseudo" allowPartial:NO];
+        NSString *username = @"";
+        if (usernameNode && ![[usernameNode getAttributeNamed:@"value"] isEqualToString:@""]) {
+            username = [usernameNode getAttributeNamed:@"value"];
+        }
+        out[@"username"] = Nullable(username);
+
+        // :143-200 custom smileys (dynamic_smilies); the cache downloads are not part of the form
+        id smileyNode = [bodyNode findChildWithAttribute:@"id" matchingName:@"dynamic_smilies" allowPartial:NO];
+        NSMutableArray *smileys = [NSMutableArray array];
