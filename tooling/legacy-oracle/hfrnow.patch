+    // MARK: kind `form`
+
+    func runForm(_ data: Data, options: [String: Any], extras: inout TopicCaseExtras) throws -> (Any?, String?) {
+        let mode = options["mode"] as? String ?? "reply"
+        guard ["reply", "quote", "edit", "delete", "newtopic", "mp", "alert"].contains(mode) else {
+            throw HarnessError(message: "form mode must be reply, quote, edit, delete, newtopic, mp or alert")
+        }
+        let session = options["session"] as? [String: String] ?? [:]
+        let pseudo = session["pseudo"] ?? "fakeuser1"
+        let hash = session["hash"] ?? "0123456789abcdef0123456789abcdef01234567"
+        let defaultURL = mode == "alert"
+            ? "https://forum.hardware.fr/user/modo.php?config=hfr.inc&cat=13&post=1000&numreponse=1002"
+            : "https://forum.hardware.fr/message.php?config=hfr.inc&cat=13&post=1000&numrep=1001&page=1&p=1&subcat=&sondage=0&owntopic=0&new=0"
+        let urlString = options["url"] as? String ?? defaultURL
+        guard let url = URL(string: urlString) else { throw HarnessError(message: "bad url") }
+        let overrides = options["overrides"] as? [String: String] ?? [:]
+        extras.context = ["mode": mode, "url": urlString, "session": ["pseudo": pseudo, "hash": hash],
+                          "message": options["message"] ?? NSNull(), "overrides": overrides]
+
+        beginWriteHooks(pseudo: pseudo, hash: hash)
+        defer { endWriteHooks() }
+        var result: [String: Any] = [:]
+
+        // (a) legacy
+        let parsed = writeCall("legacyFormParse:", ["data": data, "flavor": mode == "alert" ? "modo" : "hop"]) as? [String: Any] ?? [:]
+        var legacy = parsed
+        legacy["fetchURL"] = urlString.lowercased() // QuoteMessageViewController.m:36, AlerteModoViewController.m:40
+        let prefill = parsed["contentForm"] as? String ?? ""
+        let inputData = parsed["inputData"] as? [String: String] ?? [:]
+        let defaultMessage = "Test message\nline two: é & + = % 100%"
+        let message = options["message"] as? String ?? (["quote", "edit", "delete"].contains(mode) ? prefill : defaultMessage)
+        if parsed["exception"] == nil, !(mode == "alert" && (parsed["alreadyAlerted"] as? Bool ?? false)) {
+            var spec: [String: Any] = [
+                "flavor": mode == "alert" ? "alert" : "add", "inputData": inputData, "formSubmit": parsed["formSubmit"] ?? "",
+                "pseudo": pseudo, "hash": hash, "content": mode == "alert" ? (options["message"] as? String ?? "Alert reason") : message,
+                "haveTitle": parsed["haveTitle"] ?? false, "haveCategory": parsed["haveCategory"] ?? false, "haveTo": parsed["haveTo"] ?? false,
+                "sujet": overrides["sujet"] ?? inputData["sujet"] ?? "", "subcat": overrides["subcat"] ?? inputData["subcat"] ?? "",
+                "dest": overrides["dest"] ?? inputData["dest"] ?? "", "deleteMode": mode == "delete"
+            ]
+            if mode == "alert" { spec["inputData"] = inputData }
+            var legacyPost = writeCall("legacyPost:", spec) as? [String: Any] ?? [:]
+            // legacyPost: strips emoji (-[NSString removeEmoji]) before building the body: record the text it really sent.
+            let sent = legacyPost.removeValue(forKey: "sentContent") as? String
+            legacy["post"] = legacyPost.isEmpty ? NSNull() : legacyPost
+            legacy["postedContent"] = sent ?? NSNull()
+            if let mismatch = postedContentMismatch(selfTest(legacy["postedContent"] as? String, options), post: legacy["post"] as? [String: Any], mode: mode) {
+                return (nil, "OracleSelfCheck: legacy \(mismatch)")
+            }
+        }
+        result["legacy"] = legacy
+
+        // (b) live
+        let postPage = Data("""
+        <html><head><meta http-equiv="Refresh" content="0;url=/forum2.php?config=hfr.inc&cat=13&post=1000&page=1#t1002" /></head>\
+        <body><div class="hop">Votre message a bien été pris en compte.</div></body></html>
+        """.utf8)
+        OracleStubURLProtocol.reset(get: data, post: postPage)
+        var live: [String: Any] = [:]
+        let finished = runBlocking { [self] in
+            let provider: (HTTPCookieStorage) throws -> ReplySessionContext = { _ in ReplySessionContext(pseudoDisplay: pseudo, hashCheck: hash) }
+            let jar = oracleCookieJar()
+            switch mode {
+            case "quote":
+                let service = ForumReplyQuoteTemplateService(session: stubSession(), cookieStorage: jar, sessionContextProvider: provider)
+                do { live["quoteTemplate"] = try await service.fetchQuoteTemplate(from: url) } catch { live["quoteTemplate"] = describe(error) }
+                fallthrough
+            case "reply", "edit", "newtopic", "mp":
+                let service = ForumReplyPostingService(session: stubSession(), cookieStorage: jar, sessionContextProvider: provider)
+                do {
+                    let context = try await service.fetchComposerContext(topicURL: url)
+                    live["composerContext"] = [
+                        "subject": context.subject ?? NSNull(), "recipient": context.recipient ?? NSNull(),
+                        "isSubjectEditable": context.isSubjectEditable, "selectedSubcategoryID": context.selectedSubcategoryID ?? NSNull(),
+                        "isSubcategoryEditable": context.isSubcategoryEditable,
