+#pragma mark - LOT-003 hooks
+
+// The parsers read the own pseudo from the keychain-backed account list (MultisManager.m:43-47,168-188),
+// and ParseMessagesOperation downloads avatars with ASIHTTPRequest (ParseMessagesOperation.m:452-473).
+// For a reproducible offline run both are replaced: the account list by the case's pseudo, the network by a
+// recorder that completes each request according to the avatar mode without sending anything:
+//   succeed  run the request's completion block (the avatar is "downloaded": empty file, imageUI set)
+//   fail     run its failure block (imageUI nil)
+//   blocked  run neither (imageUI keeps what the cache check set)
+// The block runs where ASIHTTPRequest runs it: on the main thread, asynchronously when the request finishes on another
+// thread (-requestFinished / -failWithError:, ASIHTTPRequest.m:1992-2004, 2103-2108, "ALWAYS CALLED ON MAIN THREAD").
+// The avatar requests run on ParseMessagesOperation's own queue (ParseMessagesOperation.m:54, 469) while the worker
+// parses and waits on the main thread (ObjCTopicPageWorker.m:110-112), so no completion, and no cache file, can
+// appear before the page is built: running the block on the queue thread made the cache check of a later message by
+// the same author (:430-450) race the download (LOT-003 quirk Q33). That queue is also made serial, so the requests
+// are recorded in message order.
++ (void)installTopicHooks {
+    if (gOrigRequestStart != NULL) return;
+    gOracleRequests = [NSMutableArray array];
+
+    Class multis = NSClassFromString(@"MultisManager");
+    Method mainCompte = class_getInstanceMethod(multis, NSSelectorFromString(@"getMainCompte"));
+    gOrigGetMainCompte = method_setImplementation(mainCompte, imp_implementationWithBlock(^NSDictionary *(id me) {
+        // PSEUDO_DISPLAY_KEY and MAIN_KEY, Constants.h:119,121
+        if (!gOraclePseudo) return nil;
+        // LOT-004: HASH (HASH_KEY, Constants.h:120) when a write case sets one
+        return gOracleHash ? @{@"PSEUDO_DISPLAY": gOraclePseudo, @"MAIN": @YES, @"HASH": gOracleHash}
+                           : @{@"PSEUDO_DISPLAY": gOraclePseudo, @"MAIN": @YES};
+    }));
+    Method currentPseudo = class_getInstanceMethod(multis, NSSelectorFromString(@"getCurrentPseudo"));
+    gOrigGetCurrentPseudo = method_setImplementation(currentPseudo, imp_implementationWithBlock(^NSString *(id me) {
+        return gOraclePseudo;
+    }));
+
+    Class asi = NSClassFromString(@"ASIHTTPRequest");
+    Method start = class_getInstanceMethod(asi, NSSelectorFromString(@"start"));
+    gOrigRequestStart = method_setImplementation(start, imp_implementationWithBlock(^(id request) {
+        NSURL *url = [request valueForKey:@"url"];
+        NSString *mode;
+        @synchronized (gOracleRequests) {
+            [gOracleRequests addObject:url.absoluteString ?: @""];
+            mode = gOracleAvatarMode;
+        }
+        const char *ivarName = [mode isEqualToString:@"succeed"] ? "completionBlock"
+                             : [mode isEqualToString:@"fail"] ? "failureBlock" : NULL;
+        if (ivarName != NULL) {
+            Ivar ivar = class_getInstanceVariable(asi, ivarName);
+            void (^block)(void) = ivar ? object_getIvar(request, ivar) : nil;
+            if (block && [NSThread isMainThread]) {
+                block();
+            } else if (block) {
+                dispatch_async(dispatch_get_main_queue(), block);
+            }
+        }
+        ((void (*)(id, SEL))objc_msgSend)(request, NSSelectorFromString(@"markAsFinished"));
+    }));
+
+    Class parse = NSClassFromString(@"ParseMessagesOperation");
+    Method parseInit = class_getInstanceMethod(parse, NSSelectorFromString(@"initWithData:index:reverse:delegate:"));
+    gOrigParseInit = method_setImplementation(parseInit, imp_implementationWithBlock(^id(id me, NSData *data, int index, BOOL reverse, id delegate) {
+        id operation = ((id (*)(id, SEL, NSData *, int, BOOL, id))gOrigParseInit)(
+            me, NSSelectorFromString(@"initWithData:index:reverse:delegate:"), data, index, reverse, delegate);
+        NSOperationQueue *queue = [operation valueForKey:@"queue"];
+        queue.maxConcurrentOperationCount = 1;
+        return operation;
+    }));
+}
+
++ (void)removeTopicHooks {
+    if (gOrigRequestStart == NULL) return;
+    Class multis = NSClassFromString(@"MultisManager");
+    method_setImplementation(class_getInstanceMethod(multis, NSSelectorFromString(@"getMainCompte")), gOrigGetMainCompte);
+    method_setImplementation(class_getInstanceMethod(multis, NSSelectorFromString(@"getCurrentPseudo")), gOrigGetCurrentPseudo);
+    Class asi = NSClassFromString(@"ASIHTTPRequest");
+    method_setImplementation(class_getInstanceMethod(asi, NSSelectorFromString(@"start")), gOrigRequestStart);
+    Class parse = NSClassFromString(@"ParseMessagesOperation");
+    method_setImplementation(class_getInstanceMethod(parse, NSSelectorFromString(@"initWithData:index:reverse:delegate:")), gOrigParseInit);
+    gOrigGetMainCompte = gOrigGetCurrentPseudo = gOrigRequestStart = gOrigParseInit = NULL;
+    gOraclePseudo = nil;
+    gOracleHash = nil;
+    @synchronized (gOracleRequests) {
+        gOracleAvatarMode = @"succeed"; // the default, so a later case never inherits "fail" or "blocked"
+    }
+}
+
++ (void)setTopicHookPseudo:(NSString *)pseudo avatarMode:(NSString *)mode {
+    gOraclePseudo = [pseudo isKindOfClass:[NSString class]] ? [pseudo copy] : nil;
+    @synchronized (gOracleRequests) {
+        gOracleAvatarMode = [mode copy] ?: @"succeed";
+        [gOracleRequests removeAllObjects];
+    }
+}
+
++ (void)setTopicHookHash:(NSString *)hash {
+    gOracleHash = [hash isKindOfClass:[NSString class]] ? [hash copy] : nil;
+}
+
++ (NSArray *)drainNetworkRequests {
+    @synchronized (gOracleRequests) {
+        NSArray *copy = [gOracleRequests copy] ?: @[];
+        [gOracleRequests removeAllObjects];
+        return copy;
+    }
+}
