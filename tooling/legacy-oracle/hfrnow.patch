+            if let mismatch = postedContentMismatch(selfTest(intended, options), post: livePostBody, mode: mode) { return (nil, "OracleSelfCheck: live \(mismatch)") }
+        } else {
+            live["postedContent"] = postedField(livePostBody, mode: mode) ?? NSNull()
+        }
+        result["live"] = live
+        result["comparison"] = compareForms(legacy: legacy["post"] as? [String: Any], live: live["post"] as? [String: Any])
+        _ = writeCall("drainWriteLog")
+        return (result, nil)
+    }
