+/// ParseMessagesOperation on its own, as ObjCTopicPageWorker.m:110-112 (normal mode) and, for the parse call only,
+/// FilterPostsQuotes.m:279-283 (filter mode; legacy does not wait for avatars there). Exposes what the worker drops:
+/// iLastPageNumber, raw topicName. The avatar completions it queued for the main thread are drained before returning,
+/// so they never reach a later parse or case.
++ (NSDictionary *)parseMessagesRaw:(NSDictionary *)spec {
+    NSData *data = spec[@"data"];
+    BOOL filter = [spec[@"filter"] boolValue];
+    NSString *startAfter = [spec[@"startAfterPostId"] isKindOfClass:[NSString class]] ? spec[@"startAfterPostId"] : nil;
+    NSString *topicURL = [spec[@"topicUrl"] isKindOfClass:[NSString class]] ? spec[@"topicUrl"] : nil;
+    int topicPage = [spec[@"topicPage"] intValue];
+    @try {
+        NSError *error = nil;
+        id htmlParser = ((id (*)(id, SEL, NSData *, NSError **))objc_msgSend)([NSClassFromString(@"HTMLParser") alloc],
+                                                                             NSSelectorFromString(@"initWithData:error:"), data, &error);
+        id operation = ((id (*)(id, SEL, NSData *, int, BOOL, id))objc_msgSend)([NSClassFromString(@"ParseMessagesOperation") alloc],
+                                                                                NSSelectorFromString(@"initWithData:index:reverse:delegate:"),
+                                                                                data, 0, NO, nil);
+        ((void (*)(id, SEL, id, BOOL, NSString *, NSString *, int))objc_msgSend)(
+            operation, NSSelectorFromString(@"parseData:filterPostsQuotes:startAfterThisPostId:topicUrl:topicPage:"),
+            htmlParser, filter, startAfter, topicURL, topicPage);
+        ((void (*)(id, SEL))objc_msgSend)(operation, NSSelectorFromString(@"waitForPendingAvatarLoads"));
+        NSArray *items = [[operation valueForKey:@"workingArray"] copy] ?: @[];
+        OracleDrainMainQueue();
+        return @{
+            @"items": items,
+            @"topicName": [operation valueForKey:@"topicName"] ?: [NSNull null],
+            @"iLastPageNumber": [operation valueForKey:@"iLastPageNumber"] ?: @0,
+            @"iFirstPageNumber": [operation valueForKey:@"iFirstPageNumber"] ?: @0
+        };
+    } @catch (NSException *exception) {
+        return @{@"exception": OracleExceptionString(exception)};
+    }
+}
