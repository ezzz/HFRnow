+    func runStorage(_ data: Data, inDir: URL, options: [String: Any], extras: inout TopicCaseExtras) throws -> (Any?, String?) {
+        let storage = options["storage"] as? String ?? ""
+        guard ["mpstorage-page", "mpstorage-op", "keychain", "blacklist", "smileys", "offline"].contains(storage) else {
+            throw HarnessError(message: "storage must be mpstorage-page, mpstorage-op, keychain, blacklist, smileys or offline")
+        }
+        let pseudo = options["pseudo"] as? String ?? "fakeuser1"
+        extras.context = ["storage": storage, "pseudo": pseudo, "charset": options["charset"] ?? "utf-8"]
+        let spec = (try? JSONSerialization.jsonObject(with: data)) as? [String: Any] ?? [:]
+        beginWriteHooks(pseudo: pseudo, hash: "0123456789abcdef0123456789abcdef01234567")
+        defer { endWriteHooks() }
+        switch storage {
+        case "keychain": return (jsonSafe(writeCall("keychainAccounts:", spec)), nil)
+        case "blacklist": return (jsonSafe(writeCall("blacklistFiles:", spec)), nil)
+        case "smileys": return (jsonSafe(writeCall("smileyFavorites:", spec)), nil)
+        case "offline": return (jsonSafe(writeCall("offlineTopics:", spec)), nil)
+        default: break
+        }
+
+        let defaults = UserDefaults.standard
+        defaults.removeObject(forKey: "dicMPStorage_postid")
+        defaults.set(true, forKey: "mpstorage_active")
+        let mp = mpStorage()
+        mp.setValue(nil, forKey: "dData")
+        mp.setValue(nil, forKey: "sPostId")
+        mp.setValue(nil, forKey: "sNumRep")
+        mp.setValue(NSMutableArray(), forKey: "listBookmarks")
+        resetMPStorageFlags(mp)
+        let list = (NSClassFromString("BlackList") as AnyObject).perform(NSSelectorFromString("shared"))?.takeUnretainedValue() as? NSObject
+        list?.setValue(NSMutableDictionary(), forKey: "dicBlackList")
+        let encoding = charsetEncoding(options)
+        var result: [String: Any] = [:]
+
+        func snapshot() -> [String: Any] {
+            let documents = (mp.value(forKey: "dData") as? NSDictionary).map { normalizeTimestamps(jsonSafe($0)) } ?? NSNull()
+            return [
+                "dData": documents,
+                "sNumRep": plain(mp.value(forKey: "sNumRep")), "sPostId": plain(mp.value(forKey: "sPostId")),
+                "listBookmarks": (mp.value(forKey: "listBookmarks") as? [NSObject] ?? []).map(bookmarkDict),
+                "bIsMPStorageSavedSuccessfully": plain(mp.value(forKey: "bIsMPStorageSavedSuccessfully")),
+                "dicMPStorage_postid": jsonSafe(defaults.object(forKey: "dicMPStorage_postid")),
+                "mpstorage_active": defaults.bool(forKey: "mpstorage_active"),
+                "blackListOfActiveAccount": (list?.value(forKey: "dicBlackList") as? NSDictionary).map { jsonSafe($0[pseudo]) } ?? NSNull()
+            ]
+        }
+
+        if storage == "mpstorage-page" {
+            // [request safeResponseString] is what the callers pass (MPStorage.m:195-198, 340-345)
+            let page = String(data: data, encoding: encoding == String.Encoding.isoLatin1.rawValue ? .isoLatin1 : .utf8) ?? ""
+            let parse = invoke(mp, "parseMPStorage:", [page])
+            result["parse"] = ["returned": parse.result ?? NSNull(), "exception": parse.exception ?? NSNull()] as [String: Any]
+            result["state"] = snapshot()
+            let parseLog = writeCall("drainWriteLog") as? [String: Any] ?? [:]
+            result["alerts"] = parseLog["alerts"] ?? []
+            result["requests"] = describeStorageRequests(parseLog)
+            if (parse.result as? NSNumber)?.boolValue == true {
+                mp.setValue(nil, forKey: "dData")
+                let update = invoke(mp, "updateBlackList:", [page])
+                result["updateBlackList"] = ["returned": update.result ?? NSNull(), "exception": update.exception ?? NSNull(),
+                                             "blackListOfActiveAccount": (list?.value(forKey: "dicBlackList") as? NSDictionary).map { jsonSafe($0[pseudo]) } ?? NSNull()] as [String: Any]
+            }
+            _ = writeCall("drainWriteLog")
+            return (result, nil)
+        }
+
+        // mpstorage-op: a scripted read-modify-write against canned pages
+        let op = spec["op"] as? String ?? ""
+        guard ["addBlackList", "removeBlackList", "addBookmark", "removeBookmark", "save", "create", "find"].contains(op) else {
+            throw HarnessError(message: "op must be addBlackList, removeBlackList, addBookmark, removeBookmark, save, create or find")
+        }
+        mp.setValue(spec["postId"] as? String, forKey: "sPostId")
+        mp.setValue(spec["numRep"] as? String, forKey: "sNumRep")
+        if let document = spec["dData"] as? [String: Any] {
+            let copy = (try? JSONSerialization.data(withJSONObject: document))
+                .flatMap { try? JSONSerialization.jsonObject(with: $0, options: .mutableContainers) } as? NSMutableDictionary
+            mp.setValue(copy, forKey: "dData")
+        }
+        var responses: [[String: Any]] = []
+        for name in spec["responses"] as? [String] ?? [] {
+            guard let page = try? Data(contentsOf: inDir.appendingPathComponent(name)) else { throw HarnessError(message: "cannot read \(name)") }
+            responses.append(["data": page, "encoding": encoding])
+        }
+        writeVoid("setWriteResponses:", responses)
+        let args = spec["args"] as? [String: Any] ?? [:]
+        let bookmark: NSObject? = {
+            guard op.hasSuffix("Bookmark"), let type = NSClassFromString("Bookmark") as? NSObject.Type else { return nil }
+            let object = type.init()
+            for key in ["sPost", "sCat", "sNumResponse", "sLabel", "sAuthorPost"] { object.setValue(args[key], forKey: key) }
+            return object
+        }()
+        let call: (result: Any?, exception: String?)
+        switch op {
+        case "addBlackList": call = invoke(mp, "addBlackListSynchronous:", [args["pseudo"] ?? ""])
+        case "removeBlackList": call = invoke(mp, "removeBlackListSynchronous:", [args["pseudo"] ?? ""])
+        case "addBookmark": call = invoke(mp, "addBookmarkSynchronous:", [bookmark as Any])
+        case "removeBookmark": call = invoke(mp, "removeBookmarkSynchronous:", [bookmark as Any])
+        case "save": call = invoke(mp, "saveMPStorageSynchronous", [])
+        case "find": call = invoke(mp, "findStorageMPFromPage:", [1])
+        default: call = invoke(mp, "createEmptyMPStorage", [])
+        }
+        result["op"] = op
+        result["returned"] = call.result ?? NSNull()
+        result["exception"] = call.exception ?? NSNull()
+        let log = writeCall("drainWriteLog") as? [String: Any] ?? [:]
+        result["requests"] = describeStorageRequests(log)
+        result["alerts"] = log["alerts"] ?? []
+        result["unusedResponses"] = log["unusedResponses"] ?? 0
+        result["state"] = snapshot()
+        return (result, nil)
+    }
+}
