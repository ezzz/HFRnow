+        }
+        var live: [String: Any] = [:]
+        if flow != "mpstorage" {
+            let finished = runBlocking { [self] in
+                let provider: (HTTPCookieStorage) throws -> ReplySessionContext = { _ in
+                    ReplySessionContext(pseudoDisplay: "fakeuser1", hashCheck: "0123456789abcdef0123456789abcdef01234567")
+                }
+                let jar = oracleCookieJar()
+                switch flow {
+                case "reply":
+                    let service = ForumReplyPostingService(session: stubSession(), cookieStorage: jar, sessionContextProvider: provider)
+                    do { live = describe(try await service.postReply(message: "Test", topicURL: url)) } catch { live = describe(error) }
+                case "delete":
