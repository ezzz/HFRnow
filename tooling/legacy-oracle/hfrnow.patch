+                    ] as [String: Any]
+                } catch { live["composerContext"] = describe(error) }
+                _ = OracleStubURLProtocol.drain()
+                do { live["result"] = describe(try await service.postReply(message: message, topicURL: url, formOverrides: overrides)) }
+                catch { live["result"] = describe(error) }
+            case "delete":
+                let service = ForumMessageDeletionService(session: stubSession(), cookieStorage: jar, sessionContextProvider: provider)
+                do { live["result"] = describe(try await service.deleteMessage(editURL: url)) } catch { live["result"] = describe(error) }
+            default: // alert
+                let service = ForumModerationAlertService(session: stubSession(), cookieStorage: jar, sessionContextProvider: provider)
+                do {
+                    switch try await service.prepareAlert(from: url) {
+                    case .alreadyAlerted(let text): live["prepare"] = ["state": "alreadyAlerted", "message": text]
+                    case .ready(let form):
+                        live["prepare"] = ["state": "ready", "submitURL": form.submitURL.absoluteString,
+                                           "params": form.params] as [String: Any]
+                        do {
+                            let text = try await service.submitAlert(reason: options["message"] as? String ?? "Alert reason", with: form)
+                            live["result"] = ["ok": true, "statusMessage": text] as [String: Any]
+                        } catch { live["result"] = describe(error) }
+                    }
+                } catch { live["prepare"] = describe(error) }
+            }
+        }
+        if !finished { return (nil, "OracleTimeout: live write service did not finish within 30 s") }
+        let log = OracleStubURLProtocol.drain()
+        live["post"] = livePost(from: log)
+        live["requests"] = log.map { ["method": $0["method"] ?? "", "url": $0["url"] ?? ""] }
+        // What the live service really posted: the text handed to it (the composer text, or the alert reason), and for a
+        // delete the unchanged text the service reads from the edit form. Null when no POST was sent.
+        let liveIntended: String? = mode == "alert" ? (options["message"] as? String ?? "Alert reason") : (mode == "delete" ? nil : message)
+        let livePostBody = live["post"] as? [String: Any]
+        if livePostBody == nil {
+            live["postedContent"] = NSNull()
+        } else if let intended = liveIntended {
