+            }
+            if !finished { return (nil, "OracleTimeout: live classifier did not finish within 30 s") }
+            _ = OracleStubURLProtocol.drain()
+            result["live"] = live
+        } else {
+            // The real MPStorage save and create paths with this answer (MPStorage.m:738-766, 905-930)
+            let mp = mpStorage()
+            resetMPStorageFlags(mp)
+            mp.setValue(NSMutableDictionary(dictionary: ["data": [["version": "0.1"]], "sourceName": "iOS", "lastUpdate": 0]), forKey: "dData")
+            mp.setValue("123456", forKey: "sPostId")
