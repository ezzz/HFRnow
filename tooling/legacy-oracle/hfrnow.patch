+// Oracle exporter helper (SwiftHFR LOT-004): the legacy write flows and storage formats, offline.
+// Local-only: never committed to hfrnow.
+//
+// The legacy composer view controllers (QuoteMessageViewController, AddMessageViewController,
+// AlerteModoViewController) are compiled only into the old SuperHFRplus target, so they cannot be called from the
+// HFRswift test host. Their parsing and POST-building steps are transliterated here line for line, keeping the
+// legacy source line in a comment, and run on the REAL legacy building blocks the controllers use: HTMLParser/HTMLNode
+// (libxml2), ASIFormDataRequest (URL encoding of the POST body), -[NSString removeEmoji], RegexKitLite, k.ForumURL.
+// MPStorage, BlackList, SmileyCache, OfflineStorage and Topic are called as they are (all are in the HFRswift target).
+//
+// Legacy classes are reached through the runtime only: no legacy header is imported.
+#import <Foundation/Foundation.h>
+#import <UIKit/UIKit.h>
+#import <objc/message.h>
+#import <objc/runtime.h>
+
+// Selectors of the legacy classes, declared so ARC accepts messages to `id`. Nothing is implemented here.
+@interface NSObject (OracleLegacyProbe)
+- (id)initWithData:(NSData *)data error:(NSError **)error;
+- (id)initWithString:(NSString *)string error:(NSError **)error;
+- (id)body;
+- (id)findChildWithAttribute:(NSString *)attribute matchingName:(NSString *)name allowPartial:(BOOL)partial;
+- (NSArray *)findChildTags:(NSString *)tag;
+- (id)findChildTag:(NSString *)tag;
+- (NSString *)getAttributeNamed:(NSString *)name;
+- (NSString *)tagName;
+- (NSString *)contents;
+- (NSString *)allContents;
+- (NSArray *)children;
+- (id)firstChild;
+- (void)setPostValue:(id)value forKey:(NSString *)key;
+- (void)buildPostBody;
+- (NSString *)safeResponseString;
+@end
+
+@interface NSString (OracleLegacyTools)
+- (NSString *)removeEmoji;
+- (NSArray *)arrayOfCaptureComponentsMatchedByRegex:(NSString *)regex;
+@end
+
+@interface OracleLegacyWrite : NSObject
++ (void)installWriteHooks;
++ (void)removeWriteHooks;
++ (void)setWriteResponses:(NSArray *)responses;
++ (NSDictionary *)drainWriteLog;
++ (NSDictionary *)legacyFormParse:(NSDictionary *)spec;
++ (NSDictionary *)legacyPost:(NSDictionary *)spec;
++ (NSDictionary *)legacyClassify:(NSDictionary *)spec;
++ (NSDictionary *)keychainAccounts:(NSDictionary *)spec;
++ (NSDictionary *)blacklistFiles:(NSDictionary *)spec;
++ (NSDictionary *)smileyFavorites:(NSDictionary *)spec;
++ (NSDictionary *)offlineTopics:(NSDictionary *)spec;
+@end
+
+static NSMutableArray *gWriteResponses = nil;  // canned responses, popped by startSynchronous
+static NSMutableArray *gWriteRequests = nil;   // what the legacy code tried to send
+static NSMutableArray *gWriteAlerts = nil;     // alerts the legacy code tried to show
+static IMP gOrigStartSync = NULL;
+static NSMutableArray *gAlertRestore = nil;    // {class, selector, IMP}
+
+static NSString *ExceptionString(NSException *exception) {
+    return [NSString stringWithFormat:@"%@: %@", exception.name, exception.reason ?: @""];
+}
+
+static id Nullable(id value) { return value ?: [NSNull null]; }
+
+static NSString *ForumURL(void) {
+    return ((NSString * (*)(id, SEL))objc_msgSend)(NSClassFromString(@"k"), NSSelectorFromString(@"ForumURL"));
+}
+
+static NSString *Trimmed(NSString *string) {
+    return [string stringByTrimmingCharactersInSet:[NSCharacterSet whitespaceAndNewlineCharacterSet]];
+}
+
+static NSString *Base64(NSData *data) { return [data base64EncodedStringWithOptions:0]; }
+
+static id NewInstance(NSString *className) {
+    Class type = NSClassFromString(className);
+    if (type == Nil) @throw [NSException exceptionWithName:@"OracleMissingClass" reason:className userInfo:nil];
+    return [[type alloc] init];
+}
+
+/// "a=b&c=d" -> sorted [[k, v], ...] with percent-decoding; used for urlencoded bodies.
+static NSArray *SortedPairs(NSString *body) {
+    NSMutableArray *pairs = [NSMutableArray array];
+    for (NSString *part in [body componentsSeparatedByString:@"&"]) {
+        if (part.length == 0) continue;
+        NSRange eq = [part rangeOfString:@"="];
+        NSString *key = eq.location == NSNotFound ? part : [part substringToIndex:eq.location];
+        NSString *value = eq.location == NSNotFound ? @"" : [part substringFromIndex:eq.location + 1];
+        [pairs addObject:@[key.stringByRemovingPercentEncoding ?: key, value.stringByRemovingPercentEncoding ?: value]];
+    }
+    [pairs sortUsingComparator:^NSComparisonResult(NSArray *a, NSArray *b) {
+        NSComparisonResult byKey = [a[0] compare:b[0]];
+        return byKey != NSOrderedSame ? byKey : [a[1] compare:b[1]];
+    }];
+    return pairs;
+}
+
+/// Body of an ASIFormDataRequest exactly as the legacy code would put it on the wire.
+static NSDictionary *DescribePost(id request) {
+    [request buildPostBody];
+    NSData *bodyData = [request valueForKey:@"postBody"];
+    NSString *body = bodyData ? [[NSString alloc] initWithData:bodyData encoding:NSUTF8StringEncoding] : @"";
+    NSDictionary *headers = [request valueForKey:@"requestHeaders"];
+    NSURL *url = [request valueForKey:@"url"];
+    // The wire order is the NSDictionary iteration order of the caller, randomized per process: only sorted forms are exported.
+    NSArray *rawParts = [[body ?: @"" componentsSeparatedByString:@"&"] sortedArrayUsingSelector:@selector(compare:)];
+    return @{
+        @"url": Nullable(url.absoluteString),
+        @"method": @"POST",
+        @"contentType": Nullable(headers[@"Content-Type"]),
+        @"bodyBytes": @(bodyData.length),
+        @"bodySorted": [rawParts componentsJoinedByString:@"&"],
+        @"pairs": SortedPairs(body ?: @"")
+    };
+}
