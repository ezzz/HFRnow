+#pragma mark - response classification
+
+/// spec: data, encoding ("utf-8"|"iso-8859-1": what the response header would say), flavor, urlQuote.
+/// add/delete: AddMessageViewController.m:586-622 (done); alertPrepare: AlerteModoViewController.m:154-163;
+/// alertSubmit: AlerteModoViewController.m:229-236; mpstorage: MPStorage.m:752-761 (create) / 921-924, 961-964 (save).
++ (NSDictionary *)legacyClassify:(NSDictionary *)spec {
+    NSMutableDictionary *out = [NSMutableDictionary dictionary];
+    @try {
+        NSString *flavor = spec[@"flavor"];
+        NSStringEncoding encoding = [spec[@"encoding"] isEqualToString:@"iso-8859-1"] ? NSISOLatin1StringEncoding : NSUTF8StringEncoding;
+        // [arequest safeResponseString] (ASIHTTPRequest+Tools.m:40-48): iconv drops invalid UTF-8, then decodes with responseEncoding
+        id request = ((id (*)(id, SEL, NSURL *))objc_msgSend)(NSClassFromString(@"ASIHTTPRequest"), NSSelectorFromString(@"requestWithURL:"),
+                                                              [NSURL URLWithString:@"https://forum.hardware.fr/bddpost.php"]);
+        [request setValue:[spec[@"data"] mutableCopy] forKey:@"rawResponseData"];
+        [request setValue:@(encoding) forKey:@"responseEncoding"];
+        NSString *html = [request safeResponseString];
+        out[@"decoded"] = @((BOOL)(html != nil));
+        if (!html) return out;
+
+        if ([flavor isEqualToString:@"mpstorage"]) {
+            BOOL succeeded = [html containsString:@"succès"];
+            out[@"classification"] = succeeded ? @"success" : @"failure";
+            if (!succeeded) {
+                id parser = [[NSClassFromString(@"HTMLParser") alloc] initWithString:html error:nil];
+                id hop = [[parser body] findChildWithAttribute:@"class" matchingName:@"hop" allowPartial:NO];
+                out[@"message"] = Nullable([hop contents]); // not trimmed: MPStorage.m:761 passes [messagesNode contents]
+            }
+            return out;
+        }
+
+        id parser = [[NSClassFromString(@"HTMLParser") alloc] initWithString:html error:nil];
+        id hop = [[parser body] findChildWithAttribute:@"class" matchingName:@"hop" allowPartial:NO];
+        BOOL hasLink = [hop findChildTag:@"a"] != nil, hasInput = [hop findChildTag:@"input"] != nil;
+        NSString *text = Trimmed([hop contents]);
+        out[@"hopFound"] = @((BOOL)(hop != nil));
+        out[@"hopHasLink"] = @(hasLink);
+        out[@"hopHasInput"] = @(hasInput);
+        out[@"message"] = Nullable(text);
+
+        if ([flavor isEqualToString:@"alertSubmit"]) {
+            out[@"classification"] = @"alertSent"; // the legacy shows whatever .hop says (AlerteModoViewController.m:233)
