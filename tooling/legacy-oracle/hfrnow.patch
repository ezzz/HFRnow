+#pragma mark - hooks
+
+/// startSynchronous never touches the network: it logs the request (a form request is built and described) and
+/// answers with the next canned response. The legacy MPStorage uses it for every read and write (MPStorage.m:230-420).
++ (void)installWriteHooks {
+    if (gOrigStartSync != NULL) return;
+    gWriteResponses = [NSMutableArray array];
+    gWriteRequests = [NSMutableArray array];
+    gWriteAlerts = [NSMutableArray array];
+    gAlertRestore = [NSMutableArray array];
+
+    Class asi = NSClassFromString(@"ASIHTTPRequest");
+    Method startSync = class_getInstanceMethod(asi, NSSelectorFromString(@"startSynchronous"));
+    gOrigStartSync = method_setImplementation(startSync, imp_implementationWithBlock(^(id request) {
+        Class form = NSClassFromString(@"ASIFormDataRequest");
+        NSMutableDictionary *entry = [NSMutableDictionary dictionary];
+        if (form != Nil && [request isKindOfClass:form]) {
+            [entry addEntriesFromDictionary:DescribePost(request)];
+        } else {
+            NSURL *url = [request valueForKey:@"url"];
+            entry[@"url"] = Nullable(url.absoluteString);
+            entry[@"method"] = @"GET";
+        }
+        NSDictionary *response = gWriteResponses.count > 0 ? gWriteResponses.firstObject : nil;
+        if (response) [gWriteResponses removeObjectAtIndex:0];
+        entry[@"cannedResponse"] = response ? @YES : @NO;
+        [gWriteRequests addObject:entry];
+        NSData *data = response[@"data"] ?: [NSData data];
+        [request setValue:[data mutableCopy] forKey:@"rawResponseData"];
+        [request setValue:response[@"encoding"] ?: @(NSUTF8StringEncoding) forKey:@"responseEncoding"];
+    }));
+
+    // Alerts the legacy model code shows (MPStorage.m:26-52 -> HFRSwiftAlertPresenter, Common.swift:95-127) become data.
+    Class presenter = NSClassFromString(@"HFRswift.HFRSwiftAlertPresenter") ?: NSClassFromString(@"HFRSwiftAlertPresenter");
+    if (presenter != Nil) {
+        void (^hook)(NSString *, id) = ^(NSString *selectorName, id block) {
+            Method method = class_getClassMethod(presenter, NSSelectorFromString(selectorName));
+            if (method == NULL) return;
+            IMP original = method_setImplementation(method, imp_implementationWithBlock(block));
+            [gAlertRestore addObject:@[presenter, selectorName, [NSValue valueWithPointer:(const void *)original]]];
+        };
+        hook(@"displayTransientAlertWithTitle:message:duration:", ^(id me, NSString *title, NSString *message, long duration) {
+            [gWriteAlerts addObject:@{@"kind": @"transient", @"title": Nullable(title), @"message": Nullable(message)}];
+        });
+        hook(@"displayOKAlertWithTitle:message:", ^(id me, NSString *title, NSString *message) {
+            [gWriteAlerts addObject:@{@"kind": @"ok", @"title": Nullable(title), @"message": Nullable(message)}];
+        });
+        hook(@"displayOKCancelAlertWithTitle:message:okHandler:cancelHandler:",
+             ^(id me, NSString *title, NSString *message, id okHandler, id cancelHandler) {
+            [gWriteAlerts addObject:@{@"kind": @"okCancel", @"title": Nullable(title), @"message": Nullable(message)}];
+        });
+    }
+}
+
++ (void)removeWriteHooks {
+    if (gOrigStartSync == NULL) return;
+    Class asi = NSClassFromString(@"ASIHTTPRequest");
+    method_setImplementation(class_getInstanceMethod(asi, NSSelectorFromString(@"startSynchronous")), gOrigStartSync);
+    gOrigStartSync = NULL;
+    for (NSArray *saved in gAlertRestore) {
+        Method method = class_getClassMethod(saved[0], NSSelectorFromString(saved[1]));
+        if (method) method_setImplementation(method, (IMP)[saved[2] pointerValue]);
+    }
+    gAlertRestore = nil;
+}
+
+/// responses: [{data: NSData, encoding: NSNumber}] answered in order to the next startSynchronous calls.
++ (void)setWriteResponses:(NSArray *)responses {
+    [gWriteResponses removeAllObjects];
+    [gWriteResponses addObjectsFromArray:responses];
+    [gWriteRequests removeAllObjects];
+    [gWriteAlerts removeAllObjects];
+}
+
++ (NSDictionary *)drainWriteLog {
+    NSDictionary *log = @{@"requests": [gWriteRequests copy] ?: @[], @"alerts": [gWriteAlerts copy] ?: @[],
+                          @"unusedResponses": @(gWriteResponses.count)};
+    [gWriteRequests removeAllObjects];
+    [gWriteAlerts removeAllObjects];
+    return log;
+}
