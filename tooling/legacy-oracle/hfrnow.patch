+// Oracle exporter for SwiftHFR LOT-004: write flows (forms, write responses) and storage formats. Local-only.
+//
+// Kind `form`      a form page (reply, quote, edit, delete, new topic, MP, moderation alert) through
+//                  (a) the legacy extraction + POST building (OracleLegacyWrite.m, transliterated from the legacy view
+//                      controllers and run on the real HTMLParser / ASIFormDataRequest), and
+//                  (b) the live Swift services (ForumReplyPostingService, ForumReplyQuoteTemplateService,
+//                      ForumMessageDeletionService, ForumModerationAlertService) over a stubbed URLSession.
+// Kind `response`  a POST response through the legacy classifier and the live classifier (same services, POST answered
+//                  with the sample), plus the real MPStorage success test.
+// Kind `storage`   MPStorage page parsing / saving / mutation (real MPStorage.m), and synthetic on-device formats
+//                  (Keychain account blob, BlackList plists, SmileyCache, OfflineStorage) built with the real classes.
+//
+// oracle-map.json options:
+//   form      mode (reply|quote|edit|delete|newtopic|mp|alert), url, session {pseudo, hash}, message (the alert reason in alert mode), mutatePostedContent (self-test: the case must fail),
+//             overrides {sujet, subcat, dest}
+//   response  flow (reply|delete|alertPrepare|alertSubmit|mpstorage), charset (utf-8|iso-8859-1), status, urlQuote (default: a reply URL with numreponse=1003;
+//             charset only changes the legacy decoding and the MPStorage path, the live stub always answers utf-8)
+//   storage   storage (mpstorage-page|mpstorage-op|keychain|blacklist|smileys|offline), pseudo, charset
+
+import CryptoKit
+import UIKit
+import XCTest
+@testable import HFRswift
+
+/// URLProtocol answering the live services without a network: one canned answer per HTTP method, requests logged.
+final class OracleStubURLProtocol: URLProtocol, @unchecked Sendable {
+    nonisolated(unsafe) static var responses: [String: (status: Int, data: Data)] = [:]
+    nonisolated(unsafe) static var log: [[String: Any]] = []
+    private static let lock = NSLock()
+
+    static func reset(get: Data?, post: Data?, postStatus: Int = 200) {
+        lock.lock(); defer { lock.unlock() }
+        responses = [:]
+        if let get { responses["GET"] = (200, get) }
+        if let post { responses["POST"] = (postStatus, post) }
+        log = []
+    }
+
+    static func drain() -> [[String: Any]] {
+        lock.lock(); defer { lock.unlock() }
+        let copy = log
+        log = []
+        return copy
+    }
+
+    override class func canInit(with request: URLRequest) -> Bool { true }
+    override class func canonicalRequest(for request: URLRequest) -> URLRequest { request }
+
+    override func startLoading() {
+        var body = request.httpBody
+        if body == nil, let stream = request.httpBodyStream {
+            stream.open()
+            var collected = Data()
+            var buffer = [UInt8](repeating: 0, count: 4096)
+            while stream.hasBytesAvailable {
+                let count = stream.read(&buffer, maxLength: buffer.count)
+                if count <= 0 { break }
+                collected.append(buffer, count: count)
+            }
+            stream.close()
+            body = collected
+        }
+        let method = request.httpMethod ?? "GET"
+        var entry: [String: Any] = ["method": method, "url": request.url?.absoluteString ?? ""]
+        if method == "POST" {
+            entry["contentType"] = request.value(forHTTPHeaderField: "Content-Type") ?? NSNull()
+            entry["body"] = String(data: body ?? Data(), encoding: .utf8) ?? "<not UTF-8>"
+        }
+        Self.lock.lock()
+        Self.log.append(entry)
+        let answer = Self.responses[method] ?? (404, Data())
+        Self.lock.unlock()
+        let response = HTTPURLResponse(url: request.url ?? URL(string: "https://forum.hardware.fr/")!, statusCode: answer.status,
+                                       httpVersion: "HTTP/1.1", headerFields: ["Content-Type": "text/html; charset=utf-8"])!
+        client?.urlProtocol(self, didReceive: response, cacheStoragePolicy: .notAllowed)
+        client?.urlProtocol(self, didLoad: answer.data)
+        client?.urlProtocolDidFinishLoading(self)
+    }
+
+    override func stopLoading() {}
+}
+
+extension OracleExport {
+    static let writeKinds = ["form", "response", "storage"]
+
+    /// Minimal logged-in reply form served by the stub when a case only brings the POST response.
+    static let builtinReplyForm = """
+    <html><body><form name="hop" action="/bddpost.php?config=hfr.inc" method="post">\
+    <input type="hidden" name="hash_check" value="0123456789abcdef0123456789abcdef01234567" />\
+    <input type="hidden" name="cat" value="13" /><input type="hidden" name="post" value="1000" />\
+    <input name="pseudo" value="fakeuser1" /><textarea name="content_form" id="content_form"></textarea>\
+    <input type="submit" name="submit" value="Valider votre message" /></form></body></html>
+    """
+    static let builtinModoForm = """
+    <html><body><form action="modo.php?config=hfr.inc" method="post">\
+    <input type="hidden" name="hash_check" value="0123456789abcdef0123456789abcdef01234567" />\
+    <input type="hidden" name="cat" value="13" /><input type="hidden" name="post" value="1000" />\
+    <input type="hidden" name="numreponse" value="1002" /><textarea name="raison"></textarea></form></body></html>
+    """
+
+    // MARK: helpers
+
+    private func writeHelper() -> AnyObject {
+        guard let helper = NSClassFromString("OracleLegacyWrite") else { fatalError("OracleLegacyWrite missing") }
+        return helper as AnyObject
+    }
+
+    func writeCall(_ selector: String, _ first: Any? = nil) -> Any? {
+        writeHelper().perform(NSSelectorFromString(selector), with: first)?.takeUnretainedValue()
+    }
+
+    func writeVoid(_ selector: String, _ first: Any? = nil) {
+        _ = writeHelper().perform(NSSelectorFromString(selector), with: first)
+    }
+
+    private func topicHelper(_ selector: String, _ first: Any? = nil, _ second: Any? = nil) {
+        guard let helper = NSClassFromString("OracleObjCSafe") as AnyObject? else { fatalError("OracleObjCSafe missing") }
+        _ = helper.perform(NSSelectorFromString(selector), with: first, with: second)
+    }
+
+    func endWriteRun() {
+        writeVoid("removeWriteHooks")
+    }
+
+    /// Hooks for a write case: account store and ASI network replaced (topic hooks), startSynchronous and alerts recorded.
+    private func beginWriteHooks(pseudo: String?, hash: String?) {
+        topicHelper("installTopicHooks")
+        topicHelper("setTopicHookPseudo:avatarMode:", pseudo, "blocked")
+        topicHelper("setTopicHookHash:", hash)
+        writeVoid("installWriteHooks")
+        writeVoid("setWriteResponses:", [Any]())
+    }
+
+    private func endWriteHooks() {
+        writeVoid("removeWriteHooks")
+        topicHelper("removeTopicHooks")
+    }
+
+    /// Runs an async body to completion on the main actor, spinning the main run loop (the runner is synchronous).
+    func runBlocking(timeout: TimeInterval = 30, _ body: @escaping @MainActor () async -> Void) -> Bool {
+        var finished = false
+        Task { @MainActor in
+            await body()
+            finished = true
+        }
+        let deadline = Date(timeIntervalSinceNow: timeout)
+        while !finished && deadline.timeIntervalSinceNow > 0 {
+            RunLoop.main.run(mode: .default, before: Date(timeIntervalSinceNow: 0.02))
+        }
+        return finished
+    }
+
+    /// "a=b&c=d" -> pairs sorted by key then value. `plusIsSpace`: the live encoder writes spaces as "+" (ReplyService.swift:716-719),
+    /// the legacy ASIFormDataRequest writes "%20".
+    func sortedPairs(_ body: String, plusIsSpace: Bool) -> [[String]] {
+        body.split(separator: "&", omittingEmptySubsequences: true).map { part -> [String] in
+            let pieces = part.split(separator: "=", maxSplits: 1, omittingEmptySubsequences: false).map(String.init)
+            let decode = { (text: String) -> String in
+                (plusIsSpace ? text.replacingOccurrences(of: "+", with: " ") : text).removingPercentEncoding ?? text
+            }
+            return [decode(pieces[0]), decode(pieces.count > 1 ? pieces[1] : "")]
+        }
+        .sorted { ($0[0], $0[1]) < ($1[0], $1[1]) }
+    }
+
+    /// The POST the live service sent, in the same shape as the legacy one. The wire order of the live body is a
+    /// Swift Dictionary order (random per process), so only the sorted pairs are exported.
+    private func livePost(from log: [[String: Any]]) -> Any {
+        guard let entry = log.last(where: { ($0["method"] as? String) == "POST" }), let body = entry["body"] as? String else { return NSNull() }
+        let pairs = sortedPairs(body, plusIsSpace: true)
+        return [
+            "url": entry["url"] ?? NSNull(), "method": "POST", "contentType": entry["contentType"] ?? NSNull(),
+            "bodyBytes": body.utf8.count, "bodySorted": body.split(separator: "&").map(String.init).sorted().joined(separator: "&"),
+            "pairs": pairs, "bodyOrder": "unspecified (Swift Dictionary iteration)"
+        ] as [String: Any]
+    }
+
+    private func describe(_ error: Error) -> [String: Any] {
+        guard let posting = error as? ReplyPostingError else { return ["error": "other", "description": String(describing: error)] }
+        switch posting {
+        case .emptyMessage: return ["error": "emptyMessage"]
+        case .authenticationRequired: return ["error": "authenticationRequired"]
+        case .replyFormUnavailable: return ["error": "replyFormUnavailable"]
+        case .noActiveAccount: return ["error": "noActiveAccount"]
+        case .invalidResponse: return ["error": "invalidResponse"]
+        case .serverError(let status, let message): return ["error": "serverError", "statusCode": status, "message": message ?? NSNull()]
+        case .submissionRejected(let message): return ["error": "submissionRejected", "message": message ?? NSNull()]
+        }
+    }
+
+    private func describe(_ result: ReplyPostingResult) -> [String: Any] {
+        ["ok": true, "refreshAnchor": result.refreshAnchor ?? NSNull(), "refreshURL": result.refreshURL?.absoluteString ?? NSNull(),
+         "statusMessage": result.statusMessage ?? NSNull()]
+    }
+
+    /// The cookie store handed to the live services. A group-container store is persistent: it lives on disk in the
+    /// simulator and survives runs, so it is emptied for every case (the stub responses set no cookie; the live
+    /// services read the session from the injected provider, not from this store).
+    private func oracleCookieJar() -> HTTPCookieStorage {
+        let jar = HTTPCookieStorage.sharedCookieStorage(forGroupContainerIdentifier: "oracle-lot004")
+        for cookie in jar.cookies ?? [] { jar.deleteCookie(cookie) }
+        return jar
+    }
