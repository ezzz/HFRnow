+        result["legacy"] = writeCall("legacyClassify:", ["data": data, "encoding": charset, "flavor": legacyFlavor, "urlQuote": urlQuote]) ?? NSNull()
+
+        // live classification: the sample is the POST answer (alertPrepare: the GET answer)
+        let url = URL(string: flow == "alertPrepare" || flow == "alertSubmit"
+            ? "https://forum.hardware.fr/user/modo.php?config=hfr.inc&cat=13&post=1000&numreponse=1002" : urlQuote)!
+        switch flow {
+        case "alertPrepare": OracleStubURLProtocol.reset(get: data, post: nil)
