+/// The bytes the worker gets in the app: -[ASIHTTPRequest safeResponseData] (ASIHTTPRequest+Tools.m:14-38,
+/// called at ObjCTopicPageWorker.m:95) drops invalid UTF-8 sequences with iconv.
++ (NSData *)safeResponseDataFor:(NSData *)data url:(NSString *)url {
+    Class asi = NSClassFromString(@"ASIHTTPRequest");
+    id request = ((id (*)(id, SEL, NSURL *))objc_msgSend)(asi, NSSelectorFromString(@"requestWithURL:"), [NSURL URLWithString:url]);
+    [request setValue:[data mutableCopy] forKey:@"rawResponseData"];
+    return ((NSData * (*)(id, SEL))objc_msgSend)(request, NSSelectorFromString(@"safeResponseData"));
+}
+
+/// Mirrors -[ObjCTopicPageWorker fetchContentForTopicURL:anchor:completion:] (ObjCTopicPageWorker.m:78-101)
+/// without the request: the same properties are set, then the response handler runs on the saved bytes
+/// (ObjCTopicPageWorker.m:103-146). The worker dispatches its completion to the main queue (:201-208),
+/// so the main run loop is spun until it fires.
++ (NSDictionary *)runTopicWorker:(NSDictionary *)spec {
+    NSData *data = spec[@"data"];
+    NSString *currentURL = spec[@"currentURL"];
+    NSString *anchor = [spec[@"anchor"] isKindOfClass:[NSString class]] ? spec[@"anchor"] : nil;
+    id worker = [[NSClassFromString(@"ObjCTopicPageWorker") alloc] init];
+    __block BOOL done = NO;
+    __block NSDictionary *completionOut = nil;
+    void (^completion)(NSString *, NSString *, NSNumber *, NSNumber *, NSError *) =
+        ^(NSString *html, NSString *answerURL, NSNumber *currentPage, NSNumber *maxPage, NSError *error) {
+            completionOut = @{
+                @"html": html ?: [NSNull null],
+                @"answerURL": answerURL ?: [NSNull null],
+                @"currentPage": currentPage ?: [NSNull null],
+                @"maxPage": maxPage ?: [NSNull null],
+                @"error": error ? [NSString stringWithFormat:@"%@ %ld", error.domain, (long)error.code] : [NSNull null]
+            };
+            done = YES;
+        };
+    @try {
+        [worker setValue:completion forKey:@"completion"];
+        [worker setValue:currentURL forKey:@"currentURL"];
+        [worker setValue:(anchor ?: @"") forKey:@"anchor"];
+        [worker setValue:@(anchor.length > 0) forKey:@"separatorRequested"];
+        NSString *forumURL = ((NSString * (*)(id, SEL))objc_msgSend)(NSClassFromString(@"k"), NSSelectorFromString(@"ForumURL"));
+        // effectiveURL = request.url.absoluteString (ObjCTopicPageWorker.m:94); there is no redirect offline.
+        NSURL *url = [NSURL URLWithString:[NSString stringWithFormat:@"%@%@", forumURL, currentURL]];
+        ((void (*)(id, SEL, NSData *, NSString *))objc_msgSend)(worker, NSSelectorFromString(@"handleResponseData:effectiveURL:"),
+                                                               data, url.absoluteString);
+    } @catch (NSException *exception) {
+        return @{@"worker": worker, @"exception": OracleExceptionString(exception)};
+    }
+    NSDate *deadline = [NSDate dateWithTimeIntervalSinceNow:10];
+    while (!done && deadline.timeIntervalSinceNow > 0) {
+        [[NSRunLoop mainRunLoop] runMode:NSDefaultRunLoopMode beforeDate:[NSDate dateWithTimeIntervalSinceNow:0.05]];
+    }
+    if (!done) {
+        return @{@"worker": worker, @"exception": @"OracleTimeout: the worker completion did not fire within 10 s"};
+    }
+    return @{@"worker": worker, @"completion": completionOut};
+}
