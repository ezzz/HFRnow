+    /// The posted text field of a POST (`raison` for an alert, `content_form` otherwise), line breaks normalised to `\n`.
+    private func postedField(_ post: [String: Any]?, mode: String) -> String? {
+        let name = mode == "alert" ? "raison" : "content_form"
+        guard let pairs = post?["pairs"] as? [[String]], let pair = pairs.first(where: { $0[0] == name }) else { return nil }
+        return pair[1].replacingOccurrences(of: "\r\n", with: "\n")
+    }
+
+    /// Self-test of the self-check: option `mutatePostedContent: true` corrupts the expected text, so the case must fail.
+    private func selfTest(_ text: String?, _ options: [String: Any]) -> String? {
+        (options["mutatePostedContent"] as? Bool) == true ? text.map { $0 + "!" } : text
+    }
+
+    /// Harness self-check: `postedContent` must equal the text field of the body it describes. Returns a message on mismatch.
+    private func postedContentMismatch(_ posted: String?, post: [String: Any]?, mode: String) -> String? {
+        guard let posted else { return nil }
+        let field = postedField(post, mode: mode)
+        let expected = posted.replacingOccurrences(of: "\r\n", with: "\n")
+        return field == expected ? nil : "postedContent \(expected.debugDescription) differs from the posted field \(String(describing: field))"
+    }
+
+    /// Field-by-field difference between the two POSTs (names in the sorted pairs; a name repeated keeps its last value).
+    private func compareForms(legacy: [String: Any]?, live: [String: Any]?) -> [String: Any] {
+        func fields(_ post: [String: Any]?) -> [String: String]? {
+            guard let pairs = post?["pairs"] as? [[String]] else { return nil }
+            return Dictionary(pairs.map { ($0[0], $0[1]) }, uniquingKeysWith: { _, last in last })
+        }
+        guard let left = fields(legacy), let right = fields(live) else {
+            return ["comparable": false, "legacyPosted": legacy != nil, "livePosted": live != nil]
+        }
+        var different: [[String: String]] = []
+        for key in Set(left.keys).intersection(right.keys).sorted() where left[key] != right[key] {
+            different.append(["name": key, "legacy": left[key] ?? "", "live": right[key] ?? ""])
+        }
+        return [
+            "comparable": true, "onlyLegacy": Set(left.keys).subtracting(right.keys).sorted(),
+            "onlyLive": Set(right.keys).subtracting(left.keys).sorted(), "different": different,
+            "sameUrl": (legacy?["url"] as? String) == (live?["url"] as? String),
+            "legacyUrl": legacy?["url"] ?? NSNull(), "liveUrl": live?["url"] ?? NSNull()
+        ]
+    }
