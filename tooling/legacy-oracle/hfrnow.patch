+        NSArray *all = [[fastAnswerNode findChildTags:@"input"] arrayByAddingObjectsFromArray:[fastAnswerNode findChildTags:@"select"]]; // :211-214
+        BOOL haveTitle = NO, haveTo = NO, haveCategory = NO;
