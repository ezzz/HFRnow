+/// JSON-safe image of a decoded legacy object graph (cookies, dates and binary data made explicit).
+static id JSONSafe(id value) {
+    if ([value isKindOfClass:[NSHTTPCookie class]]) {
+        NSHTTPCookie *cookie = value;
+        return @{@"name": cookie.name, @"value": cookie.value, @"domain": cookie.domain, @"path": cookie.path,
+                 @"expiresDate": Nullable(ISOFromDate(cookie.expiresDate)), @"isSecure": @(cookie.isSecure),
+                 @"isHTTPOnly": @(cookie.isHTTPOnly), @"version": @(cookie.version),
+                 @"created": Nullable(cookie.properties[@"Created"])};
+    }
+    if ([value isKindOfClass:[NSDictionary class]]) {
+        NSMutableDictionary *out = [NSMutableDictionary dictionary];
+        for (id key in value) out[[key description]] = JSONSafe(value[key]);
+        return out;
+    }
+    if ([value isKindOfClass:[NSArray class]]) {
+        NSMutableArray *out = [NSMutableArray array];
+        for (id item in value) [out addObject:JSONSafe(item)];
+        return out;
+    }
+    if ([value isKindOfClass:[NSData class]]) return @{@"$data": Base64(value), @"bytes": @([value length])};
+    if ([value isKindOfClass:[NSDate class]]) return ISOFromDate(value);
+    if ([value isKindOfClass:[NSString class]] || [value isKindOfClass:[NSNumber class]] || value == [NSNull null]) return value;
+    if (value == nil) return [NSNull null];
+    return @{@"$class": NSStringFromClass([value class]), @"$description": [value description]};
+}
