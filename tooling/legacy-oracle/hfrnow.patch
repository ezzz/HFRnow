+                        case .ready(let form):
+                            if flow == "alertPrepare" {
+                                live = ["state": "ready", "submitURL": form.submitURL.absoluteString, "params": form.params]
+                            } else {
+                                do { live = ["ok": true, "statusMessage": try await service.submitAlert(reason: "Reason", with: form)] }
+                                catch { live = describe(error) }
+                            }
+                        }
+                    } catch { live = describe(error) }
