// Copy to Secrets.xcconfig (git-ignored) and fill in. Never commit the real file (ADR 0007).
// `//` starts a comment in an xcconfig: write a URL as https:/$()/host.
REHOST_BASE_URL = https:/$()/img3.super-h.fr
REHOST_API_KEY =
GIPHY_BASE_URL = https:/$()/api.giphy.com
GIPHY_API_KEY =
