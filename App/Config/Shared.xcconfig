// Build settings shared by every configuration of the app target (ADR 0007, ADR 0012).
// Empty defaults: a build without Secrets.xcconfig still builds and the features that need a key stay off.
REHOST_BASE_URL =
REHOST_API_KEY =

// Untracked file with the real values (copy Secrets.xcconfig.example); `#include?` skips it when absent.
#include? "Secrets.xcconfig"
