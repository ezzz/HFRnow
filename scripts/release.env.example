# Local settings for scripts/release-testflight.sh (LOT-161).
# Copy to ~/.config/swifthfr/release.env (outside the repository), chmod 600, fill in. Never commit the copy.
# Environment variables of the same name win over this file. The file is parsed, never sourced.

# App Store Connect API key (Users and Access > Integrations > App Store Connect API), role App Manager or higher.
# The .p8 file stays outside the repository; the script refuses a path inside it.
HFR_ASC_KEY_ID=
HFR_ASC_ISSUER_ID=
HFR_ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8

# Export signing. manual: an "Apple Distribution" certificate in the login keychain and an App Store provisioning
# profile for the app's bundle id, installed in Xcode; name it here. automatic: Xcode-managed signing, which only
# works with HFR_ALLOW_PROVISIONING_UPDATES=1 (operator opt-in; agents and CI never set it).
HFR_SIGNING_STYLE=manual
HFR_PROFILE_NAME=
# Certificate for manual signing; empty lets Xcode pick a valid distribution certificate ("Apple Distribution",
# or the legacy "iPhone Distribution").
HFR_SIGNING_CERTIFICATE=
HFR_TEAM_ID=
HFR_ALLOW_PROVISIONING_UPDATES=0

# 1 marks the build "TestFlight internal testing only" (cannot go to external testers or the App Store).
HFR_INTERNAL_ONLY=0
